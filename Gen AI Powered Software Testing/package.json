{
  "name": "gen-ai-powered-software-testing",
  "version": "1.0.0",
  "description": "Generative AI assisted KYC and AML test framework with synthetic data, Jest tests, RTM, and project reports.",
  "main": "src/index.js",
  "scripts": {
    "generate": "node scripts/generate-artifacts.js",
    "test": "node --experimental-vm-modules scripts/run-tests.js",
    "test:coverage": "node --experimental-vm-modules scripts/run-tests.js --coverage"
  },
  "keywords": [
    "kyc",
    "aml",
    "testing",
    "jest",
    "synthetic-data",
    "rtm"
  ],
  "author": "TechSpark Solutions Test Management Team",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "jest": "^30.5.2"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
